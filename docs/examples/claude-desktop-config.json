{
  "mcpServers": {
    "notebooklm": {
      "command": "python",
      "args": [
        "-m",
        "notebooklm_mcp"
      ],
      "env": {
        "NOTEBOOKLM_HOME": "/absolute/path/to/.notebooklm",
        "NOTEBOOKLM_MCP_ENABLE_DESTRUCTIVE_TOOLS": "0",
        "NOTEBOOKLM_MCP_LOG_LEVEL": "INFO",
        "NOTEBOOKLM_MCP_MAX_INFLIGHT": "5",
        "NOTEBOOKLM_MCP_TIMEOUT_MS": "30000"
      }
    }
  }
}
